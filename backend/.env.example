# ---- AI Mock Interview Bot ----
# Copy this file to `.env` and fill in the values.

# OpenAI API key. OPTIONAL.
# If left empty, the app runs in offline "mock" mode using a built-in
# rule-based question bank + heuristic scoring, so you can still demo the
# full flow without spending tokens.
OPENAI_API_KEY=

# Model used for all AI calls (question generation, evaluation, feedback).
OPENAI_MODEL=gpt-4o-mini

# Backend host/port for uvicorn.
HOST=127.0.0.1
PORT=8000

# Directory where interview sessions are persisted (JSON).
DATA_DIR=data

# Allowed CORS origins ("*" for any origin).
CORS_ORIGINS=*
